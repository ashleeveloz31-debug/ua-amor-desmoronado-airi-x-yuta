<script>
const MI_PASSWORD="30081897";
function checkPass(e){e.stopPropagation();let v=document.getElementById('pass').value;if(v===MI_PASSWORD){document.getElementById('lock').style.display='none';document.getElementById('home').style.display='block';}else{document.getElementById('error').style.display='block';document.getElementById('pass').value="";}}
