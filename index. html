function abrir(e,id){e.stopPropagation();document.querySelectorAll('.pantalla').forEach(p=>p.style.display='none');document.getElementById('home').style.display='block';document.getElementById(id).style.display='block';}
function cerrar(e){e.stopPropagation();document.querySelectorAll('.pantalla').forEach(p=>p.style.display='none');document.getElementById('home').style.display='block';}
function showEp(e,n){e.stopPropagation();document.querySelectorAll('.ep-bar button').forEach(b=>b.classList.remove('on'));e.target.classList.add('on');document.querySelectorAll('.ep-content').forEach(c=>c.style.display='none');document.getElementById('ep'+n).style.display='block';}
function playSong(el,titulo,artista){document.querySelectorAll('.song').forEach(s=>s.classList.remove('active'));el.classList.add('active');document.getElementById('now-title').textContent=titulo;document.getElementById('now-artist').textContent=artista;}
function togglePlay(e){e.stopPropagation();let b=e.target;b.textContent=b.textContent==='⏸️'?'▶️':'⏸️';}
